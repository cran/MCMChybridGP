\name{Demo}
\alias{Demo}
\title{Run the MCMChybridGP demonstration}
\usage{
Demo(...)
}
\arguments{
\item{...}{Passed to the internal demo function.}
}
\value{
Invisibly returns the demo output.
}
\description{
An interactive demonstration that prints the underlying calls to
\code{hybrid.explore()} and \code{hybrid.sample()}, and produces
graphical output. This function is the user-facing entry point for the
example shown when running \code{demo("MCMChybridGP")}.
}

